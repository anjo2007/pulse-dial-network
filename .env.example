# Safe local demo: explicitly memory-only, no Supabase/SMS/push provider.
# Never set true on Vercel; production will reject it.
DEMO_MODE=true

# Server-only production settings. Set real values in the Vercel secret manager.
# Leave provider settings EMPTY for local-only development.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
APP_JWT_SECRET=
CRON_SECRET=

# REQUIRED before production: actual hospital identity and verified dispatch location.
HOSPITAL_ID=
HOSPITAL_NAME=
HOSPITAL_LICENSE=
HOSPITAL_LATITUDE=
HOSPITAL_LONGITUDE=
# Local demo / provisioning input only; production authentication uses Supabase users.
HOSPITAL_EMAIL=
# Do not put a provisioning password in Vercel runtime configuration.
HOSPITAL_PASSWORD=

# Exact comma-separated HTTPS browser origins, including your deployed portal origin.
CORS_ALLOWED_ORIGINS=

# Build-time portal API. Same-origin is the supported Vercel setup.
VITE_API_URL=/api
# VITE_DEV_API_TARGET defaults to the local API. See apps/portal/vite.config.js.

# Server-only Expo push security token, if enhanced push security is enabled in Expo.
EXPO_ACCESS_TOKEN=
# Keep in sync with the native notification channel. Prefer the default.
EXPO_CHANNEL_ID=emergency-blood-alerts
WORKER_BATCH_SIZE=20
WORKER_CONCURRENCY=5
WORKER_BUDGET_MS=45000
OUTBOX_LEASE_MS=60000

# Mobile build configuration belongs in apps/mobile/.env (see its .env.example).
# Never prefix service-role keys, signing passwords or CRON_SECRET with VITE_/EXPO_PUBLIC_.
