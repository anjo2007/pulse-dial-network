# Server-only: configure these in Vercel Project Settings → Environment Variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
APP_JWT_SECRET=replace-with-a-long-random-secret
HOSPITAL_EMAIL=dispatch@example-hospital.org
HOSPITAL_PASSWORD=replace-with-a-long-unique-password
HOSPITAL_NAME=Example Hospital Blood Bank
HOSPITAL_LICENSE=STATE-LICENSE-NUMBER

# Build-time portal setting: `/api` when deployed on Vercel.
VITE_API_URL=/api

# Local development only. Omit this in Vercel to require Supabase Auth.
DEMO_MODE=true

# Expo client setting for a deployed API.
# EXPO_PUBLIC_API_URL=https://your-vercel-project.vercel.app/api
