# Pulse Dial donor app (apps/mobile) - public, non-secret build configuration.
# Copy to .env (never commit real values) or export these before `expo run:android` / `expo start`.
# Every value here is embedded in the client bundle: never put secrets, service keys or SMS
# credentials in EXPO_PUBLIC_* variables.

# Base URL of the Pulse API. Required for the app to do anything.
# Leave empty to force the donor to set it from Server Settings at runtime.
#
# https:// is REQUIRED for release builds: the release manifest does not allow cleartext traffic,
# so an http:// endpoint is rejected in-app and can never be reached. http:// (emulator loopback or
# a LAN address) is only accepted in __DEV__ bundles.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# EAS project id. Only needed to obtain an Expo push token (remote push delivery while the app
# is closed). Without it the app still builds and runs; alerts degrade to in-app polling and
# local notifications, and the alerting status card says so.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Set to false to skip push-token acquisition entirely (privacy-restricted builds).
EXPO_PUBLIC_PUSH_TOKEN_ENABLED=true

# Development-only local notification simulator (no network, no server). Defaults to true in
# __DEV__ builds and false in release builds.
EXPO_PUBLIC_LOCAL_ALERT_SIMULATOR=

# ---------------------------------------------------------------------------------------------
# Build-only configuration (consumed by app.config.js and Gradle, NOT embedded in the app).
# ---------------------------------------------------------------------------------------------

# Path to a real Firebase google-services.json for Android FCM. Read as a file path only - never
# printed, never inlined. If set and the file is missing, the build fails closed.
# Applied by `expo prebuild` / `expo run:android`; scripts/build-apk.js runs Gradle directly and
# therefore needs a prebuild first for this to take effect.
GOOGLE_SERVICES_FILE=

# Release signing. Release builds FAIL CLOSED without these (they must not use the debug keystore).
# Values live in your shell/CI secret store, never in this file.
# PULSE_RELEASE_STORE_FILE=C:\path\to\release.keystore
# PULSE_RELEASE_STORE_PASSWORD=
# PULSE_RELEASE_KEY_ALIAS=
# PULSE_RELEASE_KEY_PASSWORD=

# Explicit opt-in for a local DEBUG-signed build (internal testing only, never distribute).
# PULSE_ALLOW_DEBUG_SIGNING=true

# ---------------------------------------------------------------------------------------------
# Production gate (app.config.js fails closed when these are inconsistent).
# ---------------------------------------------------------------------------------------------

# Marks the build as production. EAS_BUILD=true / NODE_ENV=production / APP_ENV=production are also
# treated as production. A production build requires BOTH the EAS project id and
# GOOGLE_SERVICES_FILE (Android), unless polling-only is acknowledged below.
# PULSE_ENV=production

# A production build with push disabled only succeeds when this explicit acknowledgement is set.
# It means "this app shows requests only while it is open" - never production-ready for emergency
# alerting, and it must not be presented as such.
# PULSE_ALLOW_POLLING_ONLY=true
