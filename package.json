{
  "name": "pulse-dial",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["services/*", "apps/*"],
  "scripts": {
    "dev:api": "npm run dev --workspace @pulse/api",
    "dev:portal": "npm run dev --workspace @pulse/portal",
    "dev:mobile": "npm run start --workspace @pulse/mobile",
    "build": "npm run build --workspace @pulse/portal",
